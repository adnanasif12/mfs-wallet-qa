{
  "name": "mfs-wallet-qa",
  "version": "1.0.0",
  "description": "QA automation portfolio: Playwright UI, API and SQL ledger tests for a mock MFS wallet, with GitHub Actions CI",
  "main": "app/server.js",
  "scripts": {
    "start": "node --no-warnings app/server.js",
    "test": "cross-env NODE_OPTIONS=--no-warnings playwright test",
    "test:api": "cross-env NODE_OPTIONS=--no-warnings playwright test --project=api",
    "test:db": "cross-env NODE_OPTIONS=--no-warnings playwright test --project=db",
    "test:ui": "cross-env NODE_OPTIONS=--no-warnings playwright test --project=ui-desktop-chrome --project=ui-mobile-pixel7",
    "test:smoke": "cross-env NODE_OPTIONS=--no-warnings playwright test --grep @smoke",
    "report": "playwright show-report"
  },
  "keywords": [
    "qa",
    "playwright",
    "api-testing",
    "mfs",
    "fintech",
    "test-automation"
  ],
  "author": "Md. Adnan Asif",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
